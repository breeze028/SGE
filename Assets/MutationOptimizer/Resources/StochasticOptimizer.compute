#pragma enable_d3d11_debug_symbols

#pragma kernel Reset
#pragma kernel RandomPerturbation
#pragma kernel GradientEstimation
#pragma kernel GradientEstimationPost
#pragma kernel InitJacobiGradient
#pragma kernel GradientPrecondition
#pragma kernel GradientDescent

// Optimizer parameters
int _VertexCount;
int _SceneParametersCount; // _SceneParametersCount = _VertexCount + _TriangleCount
int _OutputWidth;
int _OutputHeight;
int _OptimizerMode;
int _LossMode;
float _DoAlphaLoss;
float _OptimizerBeta1;
float _OptimizerBeta2;
float _LearningRatePosition;
float _LearningRateColor;
float _LambdaLap;
float _Alpha;

// Scene data + scene gradients
StructuredBuffer<int> _IndexBuffer;
StructuredBuffer<int> _AdjacencyBuffer;
StructuredBuffer<int> _AdjacencyStartBuffer;
StructuredBuffer<int> _AdjacencyCountBuffer;
RWStructuredBuffer<float3> _PrimitiveBuffer;
RWStructuredBuffer<float3> _PrimitiveBufferMutated;
RWStructuredBuffer<int> _PrimitiveMutationError;
RWStructuredBuffer<int3> _PrimitiveGradientsOptimStep;
RWStructuredBuffer<int3> _JacobiGradientsIn;
RWStructuredBuffer<int3> _JacobiGradientsOut;
RWStructuredBuffer<float3> _PrimitiveGradientsMoments1;
RWStructuredBuffer<float3> _PrimitiveGradientsMoments2;
RWStructuredBuffer<int> _PrimitiveOptimStepCounter;

// Render buffers
Texture2D<float4> _IDBufferMutatedMinus;
Texture2D<float4> _IDBufferMutatedPlus;
Texture2D<float4> _ResolvedFrameMutatedMinus;
Texture2D<float4> _ResolvedFrameMutatedPlus;
Texture2D<float4> _TargetTexture;
SamplerState _LinearClampSampler;

// Misc
int _Dispatch1DOffset;
int _CurrentView;
int _CurrentOptimStep;
float _IsAntitheticMutation;

// Helpers
uint WangHash(uint seed)
{
	// Actually PCG Hash
	uint state = seed * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

uint RandXorshift(inout uint rngState)
{
	// Actually PCG Hash
	uint state = rngState;
	rngState = rngState * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

float GetRandomFloat(inout uint rngState)
{
	// -1/+1 mutations
	uint rand = RandXorshift(rngState);
	float res = float(rand) * (1.0 / 4294967296.0);
	return res > 0.5 ? 1.0 : -1.0;

	// Gaussian mutations
	/*RandXorshift(rngState);
	float res = float(rngState) * (1.0 / 4294967296.0);
	return SampleNormalDistribution(res, 0.0, 1.0);*/

	// Uniform mutations
	/*RandXorshift(rngState);
	float res = float(rngState) * (1.0 / 4294967296.0);
	return res * 2.0 - 1.0;*/
}

// Kernels
[numthreads(256, 1, 1)]
void Reset(uint3 id : SV_DispatchThreadID)
{
	uint threadID = id.x + _Dispatch1DOffset;
	if (threadID >= _SceneParametersCount)
		return;
	
	// Reset primitive gradients
	_PrimitiveGradientsOptimStep[threadID] = int3(0, 0, 0);

	// Reset primitive error
	_PrimitiveMutationError[threadID] = 0;
}

[numthreads(256, 1, 1)]
void RandomPerturbation(uint3 id : SV_DispatchThreadID)
{
	uint threadID = id.x + _Dispatch1DOffset;
	if (threadID >= _SceneParametersCount)
		return;

	uint rngState = WangHash((_CurrentView * _SceneParametersCount) + threadID);

	// Get current primitive data
	float3 primitiveData = _PrimitiveBuffer[threadID];
	
	// Create position mutation
	if (threadID < _VertexCount)
	{
		float3 randomMutation = float3(GetRandomFloat(rngState), GetRandomFloat(rngState), GetRandomFloat(rngState)) * (_IsAntitheticMutation > 0.5 ? -1.0 : 1.0);
		randomMutation *= _LearningRatePosition; // TODO : we use the learning rate as a mutation amplitude here but should be a separate parameter
		primitiveData += randomMutation;
	}
	else
	{
		// Create color mutation
		float3 colorRandomMutation = float3(GetRandomFloat(rngState), GetRandomFloat(rngState), GetRandomFloat(rngState)) * (_IsAntitheticMutation > 0.5 ? -1.0 : 1.0);
		colorRandomMutation *= _LearningRateColor;
		primitiveData += colorRandomMutation;

		// Clamp colors after mutation
		primitiveData = clamp(primitiveData, 0.0, 1.0);
	}
	
	// Store mutated primitive for rendering
	_PrimitiveBufferMutated[threadID] = primitiveData;
}

[numthreads(16, 16, 1)]
void GradientEstimation(uint3 threadID : SV_DispatchThreadID)
{
	if (threadID.x >= _OutputWidth || threadID.y >= _OutputHeight)
		return;

	// Fetch target color
	uint2 pixelCoord = threadID.xy;
	float2 pixelUV = (pixelCoord + 0.5) / float2(_OutputWidth, _OutputHeight);
	float4 targetColor = _TargetTexture.SampleLevel(_LinearClampSampler, pixelUV, 0);
	targetColor.rgb = pow(targetColor.rgb, 1.0 / 2.2) * targetColor.a;

	// Fetch mutated results (minus and plus antithetic mutations)
	float4 colorRenderMinus = _ResolvedFrameMutatedMinus.SampleLevel(_LinearClampSampler, pixelUV, 0).rgba;
	float4 colorRenderPlus = _ResolvedFrameMutatedPlus.SampleLevel(_LinearClampSampler, pixelUV, 0).rgba;
	colorRenderMinus.rgb = pow(colorRenderMinus.rgb, 1.0 / 2.2) * colorRenderMinus.a;
	colorRenderPlus.rgb = pow(colorRenderPlus.rgb, 1.0 / 2.2) * colorRenderPlus.a;

	// Compute losses
	float4 lossMinusRGBA = pow(abs(targetColor - colorRenderMinus), _LossMode == 1 ? 2.0 : 1.0);
	float4 lossPlusRGBA = pow(abs(targetColor - colorRenderPlus), _LossMode == 1 ? 2.0 : 1.0);
	float lossMinus = lossMinusRGBA.x + lossMinusRGBA.y + lossMinusRGBA.z + lossMinusRGBA.a * _DoAlphaLoss * 1;
	float lossPlus = lossPlusRGBA.x + lossPlusRGBA.y + lossPlusRGBA.z + lossPlusRGBA.a * _DoAlphaLoss * 1;

	// Loss difference
	float lossDiffFloat = lossMinus - lossPlus;

	// Quantize loss difference to integer for atomicAdd (floating point atomics not available in Unity)
	int lossDiff = lossDiffFloat * 65536;
	if (lossDiff == 0)
		return;

	// Accumulate loss for all primitives that contributed using both ID buffers, but avoid doing accumulating for same ID twice
	float4 idBufferFetch = _IDBufferMutatedPlus[pixelCoord];
	int primitiveIDPlus = asuint(idBufferFetch.r);
	if (primitiveIDPlus < _SceneParametersCount - _VertexCount)
		InterlockedAdd(_PrimitiveMutationError[primitiveIDPlus].x, lossDiff);

	idBufferFetch = _IDBufferMutatedMinus[pixelCoord];
	int primitiveIDMinus = asuint(idBufferFetch.r);
	if (primitiveIDMinus < _SceneParametersCount - _VertexCount && primitiveIDMinus != primitiveIDPlus)
		InterlockedAdd(_PrimitiveMutationError[primitiveIDMinus].x, lossDiff);
}

[numthreads(256, 1, 1)]
void GradientEstimationPost(uint3 id : SV_DispatchThreadID)
{
	uint threadID = id.x + _Dispatch1DOffset;
	if (threadID >= _SceneParametersCount)
		return;
	
	if (threadID < _VertexCount)
	{
		// uint vertexID = threadID;
		// float3 vertexPosition = _PrimitiveBuffer[vertexID];
		// // float3 vertexPositionMutationGradients = _PrimitiveGradientsOptimStep[vertexID];
		// // vertexPositionMutationGradients /= 65536;
		// float3 vertexPositionMutationGradients = 0;
		//
		// int adjacencyVertexStart = _AdjacencyStartBuffer[vertexID];
		// int adjacencyVertexCount = _AdjacencyCountBuffer[vertexID];
		//
		// float3 meanVertexPosition = 0;
		// for (int k = 0; k < adjacencyVertexCount; k++)
		// {
		// 	int adjacencyVertex = _AdjacencyBuffer[adjacencyVertexStart + k];
		// 	float3 adjacencyVertexPosition = _PrimitiveBuffer[adjacencyVertex];
		// 	meanVertexPosition += adjacencyVertexPosition;
		// }
		// meanVertexPosition /= adjacencyVertexCount;
		//
		// //float3 lap = vertexPosition - meanVertexPosition;
		// float3 lap = meanVertexPosition - vertexPosition;
		// vertexPositionMutationGradients += 2.0 * _LambdaLap * lap;
		//
		// int3 vertexPositionMutationGradientsInt = vertexPositionMutationGradients * 65536;
		// InterlockedAdd(_PrimitiveGradientsOptimStep[vertexID].x, vertexPositionMutationGradientsInt.x);
		// InterlockedAdd(_PrimitiveGradientsOptimStep[vertexID].y, vertexPositionMutationGradientsInt.y);
		// InterlockedAdd(_PrimitiveGradientsOptimStep[vertexID].z, vertexPositionMutationGradientsInt.z);
	}
	else
	{
		uint primitiveID = threadID - _VertexCount;

		// Fetch Primitive loss
		float lossDiff = _PrimitiveMutationError[primitiveID].x;
		//lossDiff = 0;
		lossDiff /= 65536;
	
		for (int i = 0; i < 3; i++)
		{
			int vertexID = _IndexBuffer[primitiveID * 3 + i];
			float3 vertexPosition = _PrimitiveBuffer[vertexID];
			float3 vertexPositionMutated = _PrimitiveBufferMutated[vertexID];
			// float3 vertexPositionMutationGradients = _PrimitiveGradientsOptimStep[vertexID];
			// vertexPositionMutationGradients /= 65536;
			float3 vertexPositionMutationGradients = 0;

			float3 mutation = vertexPositionMutated - vertexPosition;
			vertexPositionMutationGradients += mutation * lossDiff / 2.0;
		
			int3 vertexPositionMutationGradientsInt = vertexPositionMutationGradients * 65536;
			InterlockedAdd(_PrimitiveGradientsOptimStep[vertexID].x, vertexPositionMutationGradientsInt.x);
			InterlockedAdd(_PrimitiveGradientsOptimStep[vertexID].y, vertexPositionMutationGradientsInt.y);
			InterlockedAdd(_PrimitiveGradientsOptimStep[vertexID].z, vertexPositionMutationGradientsInt.z);
		}

		uint primitiveColorID = threadID;
		float3 primitiveColor = _PrimitiveBuffer[primitiveColorID];
		float3 primitiveColorMutated = _PrimitiveBufferMutated[primitiveColorID];
		float3 primitiveColorMutationGradients = _PrimitiveGradientsOptimStep[primitiveColorID];
		primitiveColorMutationGradients /= 65536;
		//float3 primitiveColorMutationGradients = 0;
	
		float3 primitiveColorMutation = primitiveColorMutated - primitiveColor;
		primitiveColorMutationGradients += primitiveColorMutation * lossDiff / 2.0;
		int3 primitiveColorMutationGradientsInt = primitiveColorMutationGradients * 65536;
		_PrimitiveGradientsOptimStep[primitiveColorID] = primitiveColorMutationGradientsInt;
	
		// Reset Primitive loss
		_PrimitiveMutationError[primitiveID] = 0;
	}
}

[numthreads(256,1,1)]
void InitJacobiGradient(uint3 id : SV_DispatchThreadID)
{
	uint v = id.x;
	if (v >= _SceneParametersCount) return;

	_JacobiGradientsIn[v] = _PrimitiveGradientsOptimStep[v];
}

// TODO: Some variables' names need changing.
[numthreads(256,1,1)]
void GradientPrecondition(uint3 id : SV_DispatchThreadID)
{
	uint v = id.x;
	if (v >= _VertexCount) return;

	float3 x_i = _JacobiGradientsIn[v];
	x_i /= 65536;
	float3 g_i = _PrimitiveGradientsOptimStep[v];
	g_i /= 65536;

	int start = _AdjacencyStartBuffer[v];
	int count = _AdjacencyCountBuffer[v];

	float3 sum = 0;

	for (int k = 0; k < count; ++k)
	{
		uint j = _AdjacencyBuffer[start + k];
		//sum += _JacobiGradientsIn[j] /= 65536.0f;
		float3 s_j =  _JacobiGradientsIn[j];
		s_j /= 65536;
		sum += s_j;
	}

	// combinatorial Laplacian
	float3 Lx = count * x_i - sum;

	// Richardson / Jacobi update
	float3 x_new =
		(1.0 - _Alpha) * x_i
		- _Alpha * _LambdaLap * Lx
		+ _Alpha * g_i;

	int3 x_new_int = x_new * 65536;
	_JacobiGradientsOut[v] = x_new_int;
}


[numthreads(256, 1, 1)]
void GradientDescent(uint3 id : SV_DispatchThreadID)
{
	uint threadID = id.x + _Dispatch1DOffset;
	if (threadID >= _SceneParametersCount)
		return;

	// Get data
	uint primitiveID = threadID;
	float3 primitiveData = _PrimitiveBuffer[primitiveID];
	float3 mutationGradients = _PrimitiveGradientsOptimStep[primitiveID];
	mutationGradients /= 65536;
	float3 gradientMoments1 = _PrimitiveGradientsMoments1[primitiveID];
	float3 gradientMoments2 = _PrimitiveGradientsMoments2[primitiveID];

	// Apply gradient descent
	if (_OptimizerMode == 0) // RMS PROP
	{
		if (_CurrentOptimStep == 0)
			return;

		if (threadID < _VertexCount)
		{
			// Descend position gradients
			float3 gradient = mutationGradients;
			gradientMoments1 = _OptimizerBeta1 * gradientMoments1 + (1.0 - _OptimizerBeta1) * (gradient * gradient);
			primitiveData += _LearningRatePosition * (gradient / (sqrt(gradientMoments1) + 1e-7));
		}
		else
		{
			// Descend color gradients
			float3 colorGradient = mutationGradients;
			gradientMoments1 = _OptimizerBeta1 * gradientMoments1 + (1.0 - _OptimizerBeta1) * (colorGradient * colorGradient);
			primitiveData += _LearningRateColor * (colorGradient / (sqrt(gradientMoments1) + 1e-7));

			// Clamp colors after gradient descent
			primitiveData = clamp(primitiveData, 0.0, 1.0);
		}


	}
	else // ADAM
	{
		int primitiveOptimStep = _PrimitiveOptimStepCounter[primitiveID];

		if (threadID < _VertexCount)
		{
			// Descend position gradients
			float3 gradient = mutationGradients;
			gradientMoments1 = _OptimizerBeta1 * gradientMoments1 + (1.0 - _OptimizerBeta1) * gradient;
			gradientMoments2 = _OptimizerBeta2 * gradientMoments2 + (1.0 - _OptimizerBeta2) * (gradient * gradient);
			float3 moment1BiasCorrected = gradientMoments1 / (1.0 - pow(_OptimizerBeta1, primitiveOptimStep + 1));
			float3 moment2BiasCorrected = gradientMoments2 / (1.0 - pow(_OptimizerBeta2, primitiveOptimStep + 1));
			// float gradientMoments2LInfinity = max(abs(gradientMoments2.x), max(abs(gradientMoments2.y), abs(gradientMoments2.z)));
			// float moment2BiasCorrected = gradientMoments2LInfinity / (1.0 - pow(_OptimizerBeta2, primitiveOptimStep + 1));
			primitiveData += _LearningRatePosition * (moment1BiasCorrected / (sqrt(moment2BiasCorrected) + 1e-7));
		}
		else
		{
			// Descend color gradients
			float3 colorGradient = mutationGradients;
			gradientMoments1 = _OptimizerBeta1 * gradientMoments1 + (1.0 - _OptimizerBeta1) * colorGradient;
			gradientMoments2 = _OptimizerBeta2 * gradientMoments2 + (1.0 - _OptimizerBeta2) * (colorGradient * colorGradient);
			float3 colorMoment1BiasCorrected = gradientMoments1 / (1.0 - pow(_OptimizerBeta1, primitiveOptimStep + 1));
			float3 colorMoment2BiasCorrected = gradientMoments2 / (1.0 - pow(_OptimizerBeta2, primitiveOptimStep + 1));
			// float gradientMoments2LInfinity = max(abs(gradientMoments2.x), max(abs(gradientMoments2.y), abs(gradientMoments2.z)));
			// float3 colorMoment2BiasCorrected = gradientMoments2LInfinity / (1.0 - pow(_OptimizerBeta2, primitiveOptimStep + 1));
			primitiveData += _LearningRateColor * (colorMoment1BiasCorrected / (sqrt(colorMoment2BiasCorrected) + 1e-7));

			// Clamp colors after gradient descent
			primitiveData = clamp(primitiveData, 0.0, 1.0);
		}
		
		// Update per-primitive step counter
		_PrimitiveOptimStepCounter[primitiveID] = primitiveOptimStep + 1;
	}

	// Write results
	_PrimitiveBuffer[primitiveID] = primitiveData;
	_PrimitiveGradientsMoments1[primitiveID] = gradientMoments1;
	_PrimitiveGradientsMoments2[primitiveID] = gradientMoments2;
}
